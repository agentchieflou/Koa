{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "attributes": {
      "class": "ms-borderColor-neutralLighter"
    },
    "style": {
      "display": "flex",
      "align-items": "flex-start",
      "box-sizing": "border-box",
      "width": "100%",
      "padding": "12px 14px",
      "border-bottom-width": "1px",
      "border-bottom-style": "solid"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "flex-grow": "1",
          "min-width": "0"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "attributes": {
              "class": "ms-fontColor-neutralPrimary"
            },
            "style": {
              "font-size": "14px",
              "font-weight": "600",
              "line-height": "1.4",
              "cursor": "pointer"
            },
            "customRowAction": {
              "action": "defaultClick"
            }
          },
          {
            "elmType": "div",
            "txtContent": "=[$IntakeType] + if([$Product.lookupValue] == '', '', ' · ' + [$Product.lookupValue])",
            "attributes": {
              "class": "ms-fontColor-neutralSecondary"
            },
            "style": {
              "font-size": "13px",
              "margin-top": "2px"
            }
          }
        ]
      },
      {
        "elmType": "a",
        "txtContent": "[$JiraKey]",
        "attributes": {
          "href": "[$JiraLink]",
          "target": "_blank",
          "class": "ms-fontColor-themeDark"
        },
        "style": {
          "font-family": "Consolas, 'Cascadia Code', monospace",
          "font-size": "13px",
          "font-weight": "600",
          "margin-left": "12px",
          "flex-shrink": "0",
          "display": "=if([$JiraKey] == '', 'none', 'inline')"
        }
      },
      {
        "elmType": "span",
        "txtContent": "[$Status]",
        "attributes": {
          "class": "=if([$Status] == 'New', 'sp-field-severity--low', if([$Status] == 'Sent to Jira', 'sp-field-severity--low', if([$Status] == 'In progress', 'sp-field-severity--low', if([$Status] == 'Waiting on you', 'sp-field-severity--warning', if([$Status] == 'Done', 'sp-field-severity--good', if([$Status] == 'Declined', 'sp-field-severity--severeWarning', ''))))))"
        },
        "style": {
          "padding": "2px 8px",
          "border-radius": "3px",
          "font-size": "12px",
          "font-weight": "600",
          "margin-left": "12px",
          "flex-shrink": "0"
        }
      }
    ]
  }
}
