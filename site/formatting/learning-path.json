{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "attributes": {
      "class": "ms-borderColor-neutralLighter"
    },
    "style": {
      "display": "flex",
      "align-items": "center",
      "box-sizing": "border-box",
      "width": "100%",
      "padding": "10px 14px",
      "border-bottom-width": "1px",
      "border-bottom-style": "solid"
    },
    "children": [
      {
        "elmType": "span",
        "txtContent": "[$StepNo]",
        "attributes": {
          "class": "ms-borderColor-themePrimary ms-fontColor-themeDarker"
        },
        "style": {
          "box-sizing": "border-box",
          "width": "26px",
          "height": "26px",
          "border-width": "2px",
          "border-style": "solid",
          "border-radius": "50%",
          "font-size": "12px",
          "font-weight": "700",
          "display": "flex",
          "align-items": "center",
          "justify-content": "center",
          "flex-shrink": "0",
          "margin-right": "12px"
        }
      },
      {
        "elmType": "a",
        "txtContent": "[$Title]",
        "attributes": {
          "href": "=if([$MoreLink] == '', '', [$MoreLink])",
          "target": "_blank",
          "class": "ms-fontColor-neutralPrimary"
        },
        "style": {
          "flex-grow": "1",
          "font-size": "14px",
          "font-weight": "600",
          "line-height": "1.35",
          "text-decoration": "none"
        }
      },
      {
        "elmType": "span",
        "txtContent": "[$ModuleFormat]",
        "attributes": {
          "class": "ms-bgColor-neutralLighter ms-fontColor-neutralPrimary"
        },
        "style": {
          "font-size": "12px",
          "padding": "1px 6px",
          "border-radius": "3px",
          "flex-shrink": "0",
          "margin-left": "12px"
        }
      }
    ]
  }
}
