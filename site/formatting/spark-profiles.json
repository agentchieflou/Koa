{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "attributes": {
      "class": "ms-borderColor-neutralLighter"
    },
    "style": {
      "display": "flex",
      "align-items": "flex-start",
      "box-sizing": "border-box",
      "width": "100%",
      "padding": "14px 16px",
      "border-bottom-width": "1px",
      "border-bottom-style": "solid"
    },
    "children": [
      {
        "elmType": "span",
        "txtContent": "[$Title]",
        "attributes": {
          "class": "ms-fontColor-themeDarker"
        },
        "style": {
          "font-family": "Consolas, 'Cascadia Code', monospace",
          "font-size": "14px",
          "font-weight": "600",
          "width": "112px",
          "flex-shrink": "0",
          "line-height": "1.5"
        }
      },
      {
        "elmType": "div",
        "style": {
          "flex-grow": "1",
          "min-width": "0"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$UseWhen]",
            "attributes": {
              "class": "ms-fontColor-neutralPrimary"
            },
            "style": {
              "font-size": "14px",
              "line-height": "1.5"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "flex-wrap": "wrap"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "='Executors ' + [$Executors]",
                "attributes": {
                  "class": "ms-bgColor-neutralLighter ms-fontColor-neutralPrimary"
                },
                "style": {
                  "font-size": "12px",
                  "padding": "1px 6px",
                  "border-radius": "3px",
                  "margin": "6px 6px 0 0",
                  "display": "=if([$Executors] == '', 'none', 'inline-block')"
                }
              },
              {
                "elmType": "span",
                "txtContent": "='Executor memory ' + [$ExecutorMemory]",
                "attributes": {
                  "class": "ms-bgColor-neutralLighter ms-fontColor-neutralPrimary"
                },
                "style": {
                  "font-size": "12px",
                  "padding": "1px 6px",
                  "border-radius": "3px",
                  "margin": "6px 6px 0 0",
                  "display": "=if([$ExecutorMemory] == '', 'none', 'inline-block')"
                }
              },
              {
                "elmType": "span",
                "txtContent": "='Cores ' + [$ExecutorCores]",
                "attributes": {
                  "class": "ms-bgColor-neutralLighter ms-fontColor-neutralPrimary"
                },
                "style": {
                  "font-size": "12px",
                  "padding": "1px 6px",
                  "border-radius": "3px",
                  "margin": "6px 6px 0 0",
                  "display": "=if([$ExecutorCores] == '', 'none', 'inline-block')"
                }
              },
              {
                "elmType": "span",
                "txtContent": "='Driver ' + [$DriverMemory]",
                "attributes": {
                  "class": "ms-bgColor-neutralLighter ms-fontColor-neutralPrimary"
                },
                "style": {
                  "font-size": "12px",
                  "padding": "1px 6px",
                  "border-radius": "3px",
                  "margin": "6px 6px 0 0",
                  "display": "=if([$DriverMemory] == '', 'none', 'inline-block')"
                }
              }
            ]
          }
        ]
      },
      {
        "elmType": "span",
        "txtContent": "Specialized",
        "attributes": {
          "class": "ms-bgColor-themeLighter ms-fontColor-themeDarker"
        },
        "style": {
          "padding": "2px 8px",
          "border-radius": "3px",
          "font-size": "12px",
          "font-weight": "600",
          "margin-left": "12px",
          "flex-shrink": "0",
          "display": "=if([$Kind] == 'Specialized', 'inline', 'none')"
        }
      }
    ]
  }
}
