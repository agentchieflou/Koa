{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "attributes": {
      "class": "ms-borderColor-neutralLighter"
    },
    "style": {
      "display": "flex",
      "align-items": "flex-start",
      "box-sizing": "border-box",
      "width": "100%",
      "padding": "12px 14px",
      "border-bottom-width": "1px",
      "border-bottom-style": "solid"
    },
    "children": [
      {
        "elmType": "span",
        "txtContent": "[$Title]",
        "attributes": {
          "class": "ms-fontColor-themeDarker"
        },
        "style": {
          "font-family": "Consolas, 'Cascadia Code', monospace",
          "font-size": "14px",
          "font-weight": "600",
          "width": "120px",
          "flex-shrink": "0",
          "line-height": "1.5"
        }
      },
      {
        "elmType": "span",
        "txtContent": "[$Definition]",
        "attributes": {
          "class": "ms-fontColor-neutralSecondary"
        },
        "style": {
          "font-size": "14px",
          "line-height": "1.5"
        }
      }
    ]
  }
}
