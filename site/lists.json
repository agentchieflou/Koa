      "seed": [
        {"Title": "Do I need to clone a repository to use the CLI?", "Answer": "No. The CLI installs straight from GitHub with pip, and project repositories install nothing: per project you only run ad-setup --project.", "Topic": "Getting started", "ShownTo": "Partners", "SortOrder": 10},
        {"Title": "Why did my update not take?", "Answer": "pip will not reinstall a git URL whose version has not changed. Run ad-update, which forces it, then start a new Copilot chat so it reads the new skills.", "Topic": "Getting started", "ShownTo": "Partners", "SortOrder": 20},
        {"Title": "Does an agent ever write to Jira on its own?", "Answer": "No. A write waits for one click from you, on the desk or on your phone.", "Topic": "The fleet", "ShownTo": "Partners", "SortOrder": 30},
        {"Title": "Which models do the agents use?", "Answer": "Cheap ones, on purpose. The platform is proven on MAI 1.1 Flash, Luna and Auto.", "Topic": "The fleet", "ShownTo": "Partners", "SortOrder": 40},
        {"Title": "How fast do you triage a request?", "Answer": "Within [N] business days. You can follow every request under My requests on Work with us.", "Topic": "Requests", "ShownTo": "Partners", "SortOrder": 50},
        {"Title": "How do I add or change a page on this site?", "Answer": "Open Copilot on the page and ask; the site skill data-czars-pages keeps it in the house style. Every page has a sheet in Koa's site/pages.", "Topic": "This site", "ShownTo": "Members", "SortOrder": 60},
        {"Title": "Where does a decision go?", "Answer": "A row in Decisions, with the context and the consequences, numbered after the last one. Superseded rows stay.", "Topic": "This site", "ShownTo": "Members", "SortOrder": 70}
      ]
    },
