        {"Title": "Jira, Bitbucket and Confluence", "Summary": "Create, triage and transition Jira issues, open pull requests, publish Markdown to Confluence.", "Category": "Developer experience", "Maturity": "GA", "Status": "Operational", "CurrentVersion": "0.18.0", "StartCommand": "ad-jira", "DocsLink": {"url": "https://github.com/agentchieflou/this-next-please/tree/main/skills/jira-router", "desc": "skills/jira-router"}, "RepoLink": {"url": "https://github.com/agentchieflou/this-next-please", "desc": "this-next-please"}, "Featured": false, "SortOrder": 90},
