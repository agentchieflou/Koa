{
  "lists": [
    {
      "name": "Tools",
      "template": 100,
      "description": "Every tool Data Czars builds and supports: one row per tool. Drives the catalog, the status strip and the featured cards.",
      "columns": [
        {"name": "Summary", "type": "Note", "description": "One or two sentences: what the tool does for the person using it."},
        {"name": "Category", "type": "Choice", "choices": ["Agent platform", "Data and BI", "Testing and UAT", "Document AI", "Developer experience", "Mobile"], "required": true},
        {"name": "Maturity", "type": "Choice", "choices": ["GA", "Preview", "Lab", "Retired"], "default": "Preview", "required": true, "description": "GA: supported for everyone. Preview: supported, still changing. Lab: try it, no promises."},
        {"name": "Status", "type": "Choice", "choices": ["Operational", "Degraded", "Maintenance", "Down"], "default": "Operational", "required": true},
        {"name": "CurrentVersion", "display": "Current version", "type": "Text"},
        {"name": "StartCommand", "display": "Start command", "type": "Text", "description": "The one command that starts the tool, as typed."},
        {"name": "DocsLink", "display": "Docs", "type": "URL"},
        {"name": "RepoLink", "display": "Repository", "type": "URL"},
        {"name": "ToolOwner", "display": "Owner", "type": "User"},
        {"name": "Featured", "type": "Boolean"},
        {"name": "SortOrder", "display": "Sort order", "type": "Number"}
      ],
      "formatters": {"Status": "formatting/tool-status.json", "Maturity": "formatting/maturity.json"},
      "views": [
        {"name": "All Items", "fields": ["LinkTitle", "Category", "Maturity", "Status", "CurrentVersion", "ToolOwner"], "query": "<OrderBy><FieldRef Name=\"SortOrder\" /></OrderBy>", "rowLimit": 100, "replace": true},
        {"name": "Catalog", "fields": ["Title", "Summary", "Category", "Maturity", "StartCommand", "DocsLink", "RepoLink", "ToolOwner"], "query": "<Where><Neq><FieldRef Name=\"Maturity\" /><Value Type=\"Choice\">Retired</Value></Neq></Where><OrderBy><FieldRef Name=\"SortOrder\" /></OrderBy>", "rowLimit": 60, "type2": "TILES", "formatter": "formatting/tools-catalog.json"},
        {"name": "Status", "fields": ["Title", "Status", "CurrentVersion"], "query": "<Where><Neq><FieldRef Name=\"Maturity\" /><Value Type=\"Choice\">Retired</Value></Neq></Where><OrderBy><FieldRef Name=\"SortOrder\" /></OrderBy>", "rowLimit": 12, "type2": "TILES", "formatter": "formatting/tools-status.json"},
        {"name": "Featured", "fields": ["Title", "Summary", "Category", "Maturity", "StartCommand", "DocsLink", "RepoLink", "ToolOwner"], "query": "<Where><Eq><FieldRef Name=\"Featured\" /><Value Type=\"Boolean\">1</Value></Eq></Where><OrderBy><FieldRef Name=\"SortOrder\" /></OrderBy>", "rowLimit": 3, "type2": "TILES", "formatter": "formatting/tools-catalog.json"}
      ],
