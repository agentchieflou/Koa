      ],
      "seed": [
        {"Title": "AGENTS.md", "Definition": "About thirty lines of project facts in each repository, pointing the agent at the installed skills."},
        {"Title": "Approval", "Definition": "A write an agent wants to make to Jira, Bitbucket or Confluence, held until a person clicks."},
        {"Title": "Bridge", "Definition": "The laptop side of FleetAgent: it writes the outbox and applies a phone's decision only after checking it."},
        {"Title": "Contract", "Definition": "The pinned JSON Schema both sides of the fleet build to, changed only by adopting a tagged version."},
        {"Title": "Desk", "Definition": "The fleet's page: one tile per registered repository."},
        {"Title": "PBIP", "Definition": "A Power BI project saved as files, so a repository can diff and review it."},
        {"Title": "Router", "Definition": "The skill that picks exactly one other skill for each request."},
        {"Title": "Skill", "Definition": "A SKILL.md with one job, read by Copilot when a chat starts."},
        {"Title": "TMDL", "Definition": "The model of a PBIP, written as text."},
        {"Title": "TOON", "Definition": "The compact table format the tools hand an agent: inline when small; header, sample and stats when not."},
        {"Title": "XMLA", "Definition": "The endpoint Tabular Editor and a refresh use to reach a Power BI semantic model."},
        {"Title": "ad-doctor", "Definition": "The offline health check: every fail row names the setting behind it and the fix."}
      ]
    },
