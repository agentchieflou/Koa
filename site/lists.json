    {
      "name": "Requests",
      "template": 100,
      "description": "Work requested from Data Czars by partners across the bank: one row per request, triaged within the promised days.",
      "columns": [
        {"name": "RequestType", "display": "Request type", "type": "Choice", "choices": ["New report or dashboard", "Data pull", "Automation or agent", "Tool access", "UAT support", "Consultation", "Problem with a tool"], "required": true},
        {"name": "Details", "type": "Note", "required": true, "description": "What you need and what decision it serves."},
        {"name": "UsedBy", "display": "Who will use it", "type": "Text"},
        {"name": "RequesterTeam", "display": "Your team", "type": "Text"},
        {"name": "NeededBy", "display": "Needed by", "type": "DateTime"},
        {"name": "Benefit", "type": "Choice", "choices": ["High", "Medium", "Low"], "default": "Medium"},
        {"name": "Status", "type": "Choice", "choices": ["New", "Triage", "Accepted", "In progress", "Blocked", "Done", "Declined"], "default": "New", "required": true},
        {"name": "Owner", "type": "User"},
        {"name": "JiraKey", "display": "Jira", "type": "Text"}
      ],
      "formatters": {"Status": "formatting/request-status.json"},
      "views": [
        {"name": "All Items", "fields": ["LinkTitle", "RequestType", "Status", "Owner", "NeededBy", "Author", "JiraKey"], "query": "<OrderBy><FieldRef Name=\"ID\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 100, "replace": true},
        {"name": "Mine", "fields": ["LinkTitle", "RequestType", "Status", "Owner", "NeededBy"], "query": "<Where><Eq><FieldRef Name=\"Author\" /><Value Type=\"Integer\"><UserID Type=\"Integer\" /></Value></Eq></Where><OrderBy><FieldRef Name=\"ID\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 30},
        {"name": "Triage", "fields": ["LinkTitle", "RequestType", "Benefit", "NeededBy", "Author", "RequesterTeam", "Status"], "query": "<Where><Or><Eq><FieldRef Name=\"Status\" /><Value Type=\"Choice\">New</Value></Eq><Eq><FieldRef Name=\"Status\" /><Value Type=\"Choice\">Triage</Value></Eq></Or></Where><OrderBy><FieldRef Name=\"ID\" /></OrderBy>", "rowLimit": 100}
      ],
      "seed": []
    },
