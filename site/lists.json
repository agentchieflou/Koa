    {
      "name": "Decisions",
      "template": 100,
      "description": "The decision log: what Data Czars decided, why, and what it costs. One row per decision; superseded rows stay.",
      "columns": [
        {"name": "DecisionNo", "display": "No.", "type": "Text", "required": true},
        {"name": "DecisionStatus", "display": "Status", "type": "Choice", "choices": ["Proposed", "Accepted", "Superseded", "Rejected"], "default": "Proposed", "required": true},
        {"name": "DecidedOn", "display": "Decided", "type": "DateTime"},
        {"name": "DecisionContext", "display": "Context", "type": "Note"},
        {"name": "DecisionText", "display": "Decision", "type": "Note"},
        {"name": "Consequences", "type": "Note"},
        {"name": "SourceRef", "display": "Source", "type": "Text"},
        {"name": "MoreLink", "display": "Link", "type": "URL"}
      ],
      "formatters": {"DecisionStatus": "formatting/decision-status.json"},
      "views": [
        {"name": "All Items", "fields": ["DecisionNo", "LinkTitle", "DecisionStatus", "DecidedOn", "SourceRef"], "query": "<OrderBy><FieldRef Name=\"DecisionNo\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 100, "replace": true},
        {"name": "Log", "fields": ["DecisionNo", "Title", "DecisionStatus", "SourceRef"], "query": "<OrderBy><FieldRef Name=\"DecisionNo\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 10, "formatter": "formatting/decisions.json"}
      ],
      "seed": [
        {"Title": "One pull request at a time; the operator merges", "DecisionNo": "001", "DecisionStatus": "Accepted", "DecisionText": "No trains in Koa: one open pull request, merged by the operator.", "SourceRef": "this-next-please#600, D11"},
        {"Title": "Fleet agents launch like a Copilot window by default", "DecisionNo": "002", "DecisionStatus": "Accepted", "DecisionText": "fleet.permissions defaults to all, autopilot on, the auto model; repo and strict stay one setting away.", "SourceRef": "#625, 0.18.0"},
        {"Title": "Custom visuals are certified-only, whatever a project says", "DecisionNo": "003", "DecisionStatus": "Accepted", "DecisionText": "A visual that is not Microsoft-certified is an ad-pbip check error and an ad-pbi publish refusal.", "SourceRef": "0.18.0"},
        {"Title": "The mobile contract is pinned, never edited", "DecisionNo": "004", "DecisionStatus": "Accepted", "DecisionText": "contract/ changes only by adopting a published mobile-contract tag, in one pull request.", "SourceRef": "Koa AGENTS.md"},
        {"Title": "The app decides nothing", "DecisionNo": "005", "DecisionStatus": "Accepted", "DecisionText": "FleetAgent shows the laptop's words verbatim; its only rule is that three missed heartbeats means not syncing.", "SourceRef": "Koa AGENTS.md"}
      ]
    },
