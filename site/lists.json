    {
      "name": "Releases",
      "template": 100,
      "description": "One row per release of a tool: what changed and whether an update needs more than the standard commands.",
      "columns": [
        {"name": "Headline", "type": "Text", "required": true},
        {"name": "Tool", "type": "Lookup", "lookup": "Tools"},
        {"name": "ReleasedOn", "display": "Released", "type": "DateTime"},
        {"name": "Kind", "type": "Choice", "choices": ["Feature", "Fix", "Breaking", "Security", "Notes"], "default": "Feature"},
        {"name": "ReleaseNotes", "display": "Notes", "type": "Note"},
        {"name": "UpdateSteps", "display": "On update", "type": "Note", "description": "What an update needs beyond ad-update and a new Copilot chat. Empty when nothing."},
        {"name": "MoreLink", "display": "Link", "type": "URL"}
      ],
      "views": [
        {"name": "All Items", "fields": ["LinkTitle", "Headline", "Tool", "Kind", "ReleasedOn"], "query": "<OrderBy><FieldRef Name=\"ReleasedOn\" Ascending=\"FALSE\" /><FieldRef Name=\"ID\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 100, "replace": true, "formatter": "formatting/releases.json"},
        {"name": "Latest", "fields": ["Title", "Headline", "Kind"], "query": "<OrderBy><FieldRef Name=\"ReleasedOn\" Ascending=\"FALSE\" /><FieldRef Name=\"ID\" Ascending=\"FALSE\" /></OrderBy>", "rowLimit": 5, "formatter": "formatting/releases.json"}
      ],
      "seed": [
        {"Title": "0.17.6", "Headline": "Voxel's hits and rewards", "Kind": "Feature", "ReleaseNotes": "An agent that errors knocks its strip.", "MoreLink": {"url": "https://github.com/agentchieflou/this-next-please/blob/main/CHANGELOG.md#0176", "desc": "CHANGELOG"}},
        {"Title": "0.17.7", "Headline": "Playbook: a coach's chalkboard skin", "Kind": "Feature", "ReleaseNotes": "Every agent is an O on the board.", "MoreLink": {"url": "https://github.com/agentchieflou/this-next-please/blob/main/CHANGELOG.md#0177", "desc": "CHANGELOG"}},
        {"Title": "0.17.8", "Headline": "Playbook's board", "Kind": "Feature", "ReleaseNotes": "One static shader under the marks: grain and haze on the slate.", "MoreLink": {"url": "https://github.com/agentchieflou/this-next-please/blob/main/CHANGELOG.md#0178", "desc": "CHANGELOG"}},
        {"Title": "0.18.0", "Headline": "Fleet agents launch like a Copilot window", "Kind": "Feature", "ReleaseNotes": "Every tool on, autopilot on, the auto model. Custom visuals are certified-only whatever a project says. Verified against Power BI Desktop 2.157.", "UpdateSteps": "The two standard commands, then start a new Copilot chat.", "MoreLink": {"url": "https://github.com/agentchieflou/this-next-please/blob/main/CHANGELOG.md#0180", "desc": "CHANGELOG"}}
